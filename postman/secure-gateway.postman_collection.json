              "pm.collectionVariables.set(\"adminToken\", pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Create product as admin (expect 201, saves id)",
      "request": {
        "method": "POST",
        "header": [
