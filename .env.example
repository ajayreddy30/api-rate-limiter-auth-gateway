# Copy to .env and fill in real values - or run scripts/generate-env.ps1 (Windows) / scripts/generate-env.sh (Linux/Mac),
# which creates .env with strong random secrets for you. NEVER commit .env.

# --- Secrets (each must be random; generate-env creates them) ---
JWT_SECRET=CHANGE_ME
INTERNAL_API_KEY=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
AUTH_DB_PASSWORD=CHANGE_ME
PRODUCT_DB_PASSWORD=CHANGE_ME

# --- Database names / users ---
AUTH_DB_NAME=authdb
AUTH_DB_USER=auth_user
PRODUCT_DB_NAME=productdb
PRODUCT_DB_USER=product_user

# --- JWT ---
JWT_ISSUER=api-gateway-auth
JWT_AUDIENCE=api-gateway
JWT_EXPIRATION_MINUTES=15

# --- Gateway behaviour ---
# true when deployed behind HTTPS (the gateway then rejects plain-HTTP requests).
REQUIRE_HTTPS=false
# Number of trusted reverse proxies in front of the gateway (0 = none, 1 = Caddy/PaaS edge).
TRUSTED_PROXY_HOPS=0
# Comma-separated browser origins allowed to call the API. Empty = no cross-origin browser access.
CORS_ALLOWED_ORIGINS=

# --- First admin account (created once at auth-service start-up if it does not exist) ---
# Remove these two lines (and restart) after the first successful start.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Production only (docker-compose.prod.yml) ---
DOMAIN=localhost
